// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_wrap_guides": true,
  "minimum_contrast_for_highlights": 45.0,
  "rounded_selection": true,
  "cursor_shape": "bar",
  "buffer_font_weight": 400.0,
  "colorize_brackets": false,
  "tasks": {
    "enabled": false
  },
  "inlay_hints": {
    "show_background": false,
    "show_value_hints": true,
    "enabled": false
  },
  "inline_code_actions": true,
  "gutter": {
    "min_line_number_digits": 4,
    "folds": false,
    "breakpoints": false,
    "runnables": false,
    "line_numbers": true
  },
  "scrollbar": {
    "axes": {
      "vertical": true,
      "horizontal": true
    },
    "show": "never",
    "selected_symbol": true,
    "diagnostics": "all",
    "cursors": true
  },
  "drag_and_drop_selection": {
    "enabled": false
  },
  "sticky_scroll": {
    "enabled": true
  },
  "autoscroll_on_clicks": true,
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "tabs": {
    "close_position": "right",
    "git_status": false
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_icon": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": true
  },
  "terminal": {
    "button": true
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true
  },
  "debugger": {
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "toolbar": {
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false,
    "agent_review": false
  },
  "project_panel": {
    "button": true,
    "dock": "right"
  },
  "relative_line_numbers": "enabled",
  "ui_font_weight": 400.0,
  "ui_font_family": "CaskaydiaCove Nerd Font",
  "buffer_line_height": "comfortable",
  "agent": {
    "default_profile": "write",
    "profiles": {
      "test": {
        "default_model": {
          "provider": "copilot_chat",
          "model": "claude-sonnet-4.5"
        },
        "name": "Test",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "dock": "left",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5"
    },
    "model_parameters": []
  },
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "icon_theme": "Colored Zed Icons Theme Light",
  "ui_font_size": 17.0,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Everforest Dark Medium",
    "dark": "Everforest Dark Medium"
  },
  "edit_predictions": {
    "copilot": {
      "enterprise_uri": "https://bmw.ghe.com/"
    }
  }
}
